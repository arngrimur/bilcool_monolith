# Copy to terraform.tfvars (gitignored) and fill in the REPLACE_ME values.
#
# Keep SECRETS out of this file: supply them as TF_VAR_* environment variables instead. A value set in
# terraform.tfvars overrides the matching TF_VAR_* variable, so never leave a dummy value for a secret here.

aws_region  = "eu-north-1"
environment = "production"

# Frostmoln Postgres: `terraform output db_host` in infrastructure/frostmoln/terraform
db_host = "REPLACE_ME"
db_port = 5432

# The sender must be verified in Brevo
from_email              = "REPLACE_ME@yourdomain.com"
webauthn_rp_id          = "bilcool.areskiftet44.se"
webauthn_rp_origins     = "https://bilcool.areskiftet44.se"
webauthn_display_name   = "BilCool"
domain_name             = "bilcool.areskiftet44.se"
lambda_artifacts_bucket = "bilcool-lambda-artifacts"
frontend_bucket_name    = "bilcool-frontend"

# Secrets: export as environment variables, do not put them here.
#   . ../../frostmoln/bootstrap/db-credentials.env     # exports TF_VAR_db_passwords (bookings, authentication, journal)
#   export TF_VAR_jwt_secret=...
#   export TF_VAR_brevo_api_key=...
#   export TF_VAR_mapbox_access_token=...
#   export TF_VAR_neon_api_key=...                     # unused leftover, any dummy value; variable is still declared in variables.tf
